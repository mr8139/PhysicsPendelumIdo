<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".AnimationFragment">

    <TextView
        android:id="@+id/tvPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Period (T): 0.00s"
        android:textSize="18sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvLengthLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pendulum Length"
        android:layout_gravity="center_horizontal"/>

    <SeekBar
        android:id="@+id/sbLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="800"
        android:progress="300"
        android:layout_marginBottom="16dp"/>

    <ido.dotan.physicspendelumido.PendulumView
        android:id="@+id/pendulumView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0"/>

</LinearLayout>