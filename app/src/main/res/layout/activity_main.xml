<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:background="@color/surface"
        android:elevation="4dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Pendulum Pro"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/fragment_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/menu_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:icon="@drawable/ic_menu"
                    android:text="@string/menu" />

                <Button
                    android:id="@+id/login_button"
                    style="@style/SideMenuButton"
                    android:text="@string/log_in" />

                <Button
                    android:id="@+id/registry_button"
                    style="@style/SideMenuButton"
                    android:text="@string/registry" />

                <Button
                    android:id="@+id/calculations_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/calculations" />

                <Button
                    android:id="@+id/animation_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/animation" />

                <Button
                    android:id="@+id/Formulas_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/formulas" />

                <Button
                    android:id="@+id/graphics_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/graphics" />

                <Button
                    android:id="@+id/history_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/history" />

                <Button
                    android:id="@+id/video_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/video" />

                <Button
                    android:id="@+id/sensors_button"
                    style="@style/SideMenuButton"
                    android:enabled="false"
                    android:text="@string/sensors" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7.5"
        android:padding="16dp" />

</LinearLayout>